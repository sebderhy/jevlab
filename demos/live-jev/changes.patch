diff --git a/.env.example b/.env.example
index f76dddf..fcc7e6e 100644
--- a/.env.example
+++ b/.env.example
@@ -1,17 +1,15 @@
-# Get a key at https://console.typesafe.ai/settings/keys
+# Jev (TypeSafe): https://console.typesafe.ai/settings/keys
 TYPESAFE_API_KEY=
-# Optional overrides
-# TYPESAFE_DEFAULT_MODEL=jev-latest
-# JEV_TIMEOUT_MS=4000
-# PORT=3000
+PORT=3001
 
-# Optional: enables the "Jev vs LLM" side-by-side comparison (https://openrouter.ai/keys)
-OPENROUTER_API_KEY=
-OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
-# LLM_TIMEOUT_MS=15000
-# OPENROUTER_REASONING=low   # let the LLM think first (slower, more tokens); off by default
-# Pricing overrides in USD per million tokens (LLM pricing is fetched from OpenRouter when unset)
-# JEV_PRICE_INPUT_PER_M=0.042
-# JEV_PRICE_OUTPUT_PER_M=0
-# LLM_PRICE_INPUT_PER_M=
-# LLM_PRICE_OUTPUT_PER_M=
+# Second brain: any OpenAI-compatible chat endpoint. The deck used DeepSeek V4.1 Flash on Fireworks.
+LLM_BASE_URL=https://api.fireworks.ai/inference/v1
+LLM_API_KEY=
+LLM_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
+LLM_PRICE_INPUT_PER_M=0.30
+LLM_PRICE_OUTPUT_PER_M=1.20
+
+# Local open models served by ../../local_server.py (and app.py for Laya), routed as /api/<name>-decide
+LOCAL_BRAINS={"laya":"http://127.0.0.1:3210","decider":"http://127.0.0.1:3211","kev":"http://127.0.0.1:3212"}
+# Which local model the browser's third track uses
+LAYA_ENGINE=laya
